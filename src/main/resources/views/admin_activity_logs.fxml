<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="900" prefWidth="1400" style="-fx-background-color:#f4f6fa;"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ca.seneca.application.controller.AdminActivityLogsController">
    <children>

        <!-- SIDEBAR -->
        <VBox layoutX="0" layoutY="0" prefHeight="900" prefWidth="240" spacing="8"
              style="-fx-background-color:#183153;">
            <padding><Insets top="28" left="16" right="16" bottom="20"/></padding>
            <children>
                <Label text="Hotel Admin" style="-fx-text-fill:white; -fx-font-size:20; -fx-font-weight:bold;"/>
                <Label text="Activity Logs" style="-fx-text-fill:#c7d4ea; -fx-font-size:12;"/>
                <Separator style="-fx-background-color:#2e5b91;"/>
                <Button prefWidth="208" prefHeight="38" text="✕  Close Window"
                        style="-fx-background-color:#c0392b; -fx-text-fill:white; -fx-alignment:BASELINE_LEFT; -fx-background-radius:8;"
                        onAction="#handleClose"/>
            </children>
        </VBox>

        <!-- TITLE -->
        <Label layoutX="268" layoutY="28"
               style="-fx-font-size:26; -fx-font-weight:bold; -fx-text-fill:#183153;"
               text="🗒 Activity Logs"/>

        <!-- SEARCH -->
        <HBox layoutX="268" layoutY="76" spacing="12" alignment="CENTER_LEFT">
            <children>
                <TextField fx:id="searchField" prefWidth="300" prefHeight="34"
                           promptText="Search action, user, or details..."/>
                <Button text="Search" prefHeight="34"
                        style="-fx-background-color:#183153; -fx-text-fill:white; -fx-background-radius:8;"
                        onAction="#handleSearch"/>
                <Button text="🔄 Refresh" prefHeight="34"
                        style="-fx-background-color:#2e5b91; -fx-text-fill:white; -fx-background-radius:8;"
                        onAction="#handleRefresh"/>
            </children>
        </HBox>

        <!-- TABLE -->
        <TableView fx:id="logsTable" layoutX="268" layoutY="124" prefHeight="712" prefWidth="1116">
            <columns>
                <TableColumn fx:id="colTimestamp"   prefWidth="180" text="Timestamp"/>
                <TableColumn fx:id="colAction"      prefWidth="200" text="Action"/>
                <TableColumn fx:id="colPerformedBy" prefWidth="160" text="Performed By"/>
                <TableColumn fx:id="colDetails"     prefWidth="570" text="Details"/>
            </columns>
            <placeholder>
                <Label text="No activity logs found." style="-fx-text-fill:#516173;"/>
            </placeholder>
        </TableView>

        <Button layoutX="268" layoutY="848" text="✕  Close" prefHeight="38" prefWidth="120"
                style="-fx-background-color:#516173; -fx-text-fill:white; -fx-background-radius:8;"
                onAction="#handleClose"/>

    </children>
</AnchorPane>
