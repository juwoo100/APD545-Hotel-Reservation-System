<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="900" prefWidth="1400"
            style="-fx-background-color:linear-gradient(to bottom,#f6f8fb,#e9eef5);"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ca.seneca.application.controller.KioskAddonsController">
    <children>
        <VBox layoutX="20" layoutY="20" prefHeight="860" prefWidth="240" spacing="16"
              style="-fx-background-color:#183153; -fx-background-radius:16;">
            <padding><Insets top="28" left="20" right="20" bottom="28"/></padding>
            <children>
                <Label text="Sheraton Hotel" style="-fx-text-fill:white; -fx-font-size:22; -fx-font-weight:bold;"/>
                <Label text="Step 5 of 6"    style="-fx-text-fill:#c7d4ea; -fx-font-size:13;"/>
                <Separator opacity="0.3"/>
                <Label text="✅ Guests"  style="-fx-text-fill:#8aaccc; -fx-font-size:12;"/>
                <Label text="✅ Dates"   style="-fx-text-fill:#8aaccc; -fx-font-size:12;"/>
                <Label text="✅ Rooms"   style="-fx-text-fill:#8aaccc; -fx-font-size:12;"/>
                <Label text="✅ Details" style="-fx-text-fill:#8aaccc; -fx-font-size:12;"/>
                <Label text="▶ Add-Ons" style="-fx-text-fill:white; -fx-font-size:12; -fx-font-weight:bold;"/>
                <Label text="○ Review"  style="-fx-text-fill:#8aaccc; -fx-font-size:12;"/>
            </children>
        </VBox>

        <VBox layoutX="295" layoutY="50" prefWidth="720" spacing="24">
            <children>
                <Label text="Step 5: Add-On Services"
                       style="-fx-font-size:34; -fx-font-weight:bold; -fx-text-fill:#183153;"/>
                <Label text="Enhance your stay with optional services. All prices shown are per reservation."
                       style="-fx-font-size:15; -fx-text-fill:#516173;"/>

                <VBox spacing="20" style="-fx-background-color:white; -fx-padding:32; -fx-background-radius:14; -fx-border-color:#d9e2ec; -fx-border-radius:14;">
                    <children>
                        <!-- WiFi -->
                        <HBox spacing="20" alignment="CENTER_LEFT"
                              style="-fx-background-color:#f8fafc; -fx-padding:16; -fx-background-radius:10; -fx-border-color:#e4eaf2; -fx-border-radius:10;">
                            <children>
                                <CheckBox fx:id="wifiCheckBox" onAction="#onWifiToggled"/>
                                <VBox>
                                    <Label text="📶  Wi-Fi Access" style="-fx-font-size:16; -fx-font-weight:bold;"/>
                                    <Label text="High-speed internet throughout your stay — $15 flat" style="-fx-text-fill:#516173;"/>
                                </VBox>
                            </children>
                        </HBox>
                        <!-- Breakfast -->
                        <HBox spacing="20" alignment="CENTER_LEFT"
                              style="-fx-background-color:#f8fafc; -fx-padding:16; -fx-background-radius:10; -fx-border-color:#e4eaf2; -fx-border-radius:10;">
                            <children>
                                <CheckBox fx:id="breakfastCheckBox" onAction="#onBreakfastToggled"/>
                                <VBox>
                                    <Label text="🍳  Daily Breakfast" style="-fx-font-size:16; -fx-font-weight:bold;"/>
                                    <Label text="Full buffet breakfast each morning — $20/night" style="-fx-text-fill:#516173;"/>
                                </VBox>
                            </children>
                        </HBox>
                        <!-- Parking -->
                        <HBox spacing="20" alignment="CENTER_LEFT"
                              style="-fx-background-color:#f8fafc; -fx-padding:16; -fx-background-radius:10; -fx-border-color:#e4eaf2; -fx-border-radius:10;">
                            <children>
                                <CheckBox fx:id="parkingCheckBox" onAction="#onParkingToggled"/>
                                <VBox>
                                    <Label text="🚗  Parking" style="-fx-font-size:16; -fx-font-weight:bold;"/>
                                    <Label text="Secure underground parking — $25/night" style="-fx-text-fill:#516173;"/>
                                </VBox>
                            </children>
                        </HBox>
                        <!-- Spa -->
                        <HBox spacing="20" alignment="CENTER_LEFT"
                              style="-fx-background-color:#f8fafc; -fx-padding:16; -fx-background-radius:10; -fx-border-color:#e4eaf2; -fx-border-radius:10;">
                            <children>
                                <CheckBox fx:id="spaCheckBox" onAction="#onSpaToggled"/>
                                <VBox>
                                    <Label text="💆  Spa Access" style="-fx-font-size:16; -fx-font-weight:bold;"/>
                                    <Label text="Full-day access to pools, sauna &amp; treatments — $60 flat" style="-fx-text-fill:#516173;"/>
                                </VBox>
                            </children>
                        </HBox>

                        <Label fx:id="addOnTotalLabel"
                               style="-fx-font-size:15; -fx-font-weight:bold; -fx-text-fill:#183153;"
                               text="Add-ons subtotal: $0.00"/>
                    </children>
                </VBox>

                <HBox spacing="16">
                    <children>
                        <Button text="← Back" prefWidth="150" prefHeight="46"
                                style="-fx-background-color:#dfe6ee; -fx-background-radius:10;"
                                onAction="#handleBack"/>
                        <Button text="Review Booking →" prefWidth="200" prefHeight="46"
                                style="-fx-background-color:#183153; -fx-text-fill:white; -fx-font-weight:bold; -fx-background-radius:10;"
                                onAction="#handleNext"/>
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>
