<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="900" prefWidth="1400"
            style="-fx-background-color:linear-gradient(to bottom,#f6f8fb,#e9eef5);"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ca.seneca.application.controller.KioskGuestDetailsController">
    <children>
        <VBox layoutX="20" layoutY="20" prefHeight="860" prefWidth="240" spacing="16"
              style="-fx-background-color:#183153; -fx-background-radius:16;">
            <padding><Insets top="28" left="20" right="20" bottom="28"/></padding>
            <children>
                <Label text="Sheraton Hotel" style="-fx-text-fill:white; -fx-font-size:22; -fx-font-weight:bold;"/>
                <Label text="Step 4 of 6"    style="-fx-text-fill:#c7d4ea; -fx-font-size:13;"/>
                <Separator opacity="0.3"/>
                <Label text="✅ Guests"  style="-fx-text-fill:#8aaccc; -fx-font-size:12;"/>
                <Label text="✅ Dates"   style="-fx-text-fill:#8aaccc; -fx-font-size:12;"/>
                <Label text="✅ Rooms"   style="-fx-text-fill:#8aaccc; -fx-font-size:12;"/>
                <Label text="▶ Details" style="-fx-text-fill:white; -fx-font-size:12; -fx-font-weight:bold;"/>
                <Label text="○ Add-Ons" style="-fx-text-fill:#8aaccc; -fx-font-size:12;"/>
                <Label text="○ Review"  style="-fx-text-fill:#8aaccc; -fx-font-size:12;"/>
            </children>
        </VBox>

        <VBox layoutX="295" layoutY="40" prefWidth="700" spacing="24">
            <children>
                <Label text="Step 4: Your Details"
                       style="-fx-font-size:34; -fx-font-weight:bold; -fx-text-fill:#183153;"/>

                <VBox spacing="14" style="-fx-background-color:white; -fx-padding:30; -fx-background-radius:14; -fx-border-color:#d9e2ec; -fx-border-radius:14;">
                    <children>
                        <Label text="First Name *" style="-fx-font-size:13; -fx-text-fill:#516173;"/>
                        <TextField fx:id="firstNameField" prefHeight="40" promptText="Enter first name"/>

                        <Label text="Last Name *" style="-fx-font-size:13; -fx-text-fill:#516173;"/>
                        <TextField fx:id="lastNameField" prefHeight="40" promptText="Enter last name"/>

                        <Label text="Phone Number *" style="-fx-font-size:13; -fx-text-fill:#516173;"/>
                        <TextField fx:id="phoneField" prefHeight="40" promptText="e.g. 4165550100"/>

                        <Label text="Email (optional)" style="-fx-font-size:13; -fx-text-fill:#516173;"/>
                        <TextField fx:id="emailField" prefHeight="40" promptText="your@email.com"/>

                        <Label text="Address (optional)" style="-fx-font-size:13; -fx-text-fill:#516173;"/>
                        <TextField fx:id="addressField" prefHeight="40" promptText="Street address"/>

                        <HBox spacing="12">
                            <children>
                                <VBox spacing="4" HBox.hgrow="ALWAYS">
                                    <Label text="City" style="-fx-font-size:13; -fx-text-fill:#516173;"/>
                                    <TextField fx:id="cityField" prefHeight="40" promptText="City"/>
                                </VBox>
                                <VBox spacing="4" HBox.hgrow="ALWAYS">
                                    <Label text="Country" style="-fx-font-size:13; -fx-text-fill:#516173;"/>
                                    <TextField fx:id="countryField" prefHeight="40" promptText="Country"/>
                                </VBox>
                            </children>
                        </HBox>

                        <Label fx:id="validationLabel" style="-fx-text-fill:#c0392b; -fx-font-size:13;" text=""/>
                    </children>
                </VBox>

                <HBox spacing="16">
                    <children>
                        <Button text="← Back" prefWidth="150" prefHeight="46"
                                style="-fx-background-color:#dfe6ee; -fx-background-radius:10;"
                                onAction="#handleBack"/>
                        <Button text="Next →" prefWidth="150" prefHeight="46"
                                style="-fx-background-color:#183153; -fx-text-fill:white; -fx-font-weight:bold; -fx-background-radius:10;"
                                onAction="#handleNext"/>
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>
