<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="900" prefWidth="1400" style="-fx-background-color:#f4f6fa;"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ca.seneca.application.controller.AdminRevenueReportController">
    <children>

        <!-- SIDEBAR -->
        <VBox layoutX="0" layoutY="0" prefHeight="900" prefWidth="240" spacing="8"
              style="-fx-background-color:#183153;">
            <padding><Insets top="28" left="16" right="16" bottom="20"/></padding>
            <children>
                <Label text="Hotel Admin" style="-fx-text-fill:white; -fx-font-size:20; -fx-font-weight:bold;"/>
                <Label text="Revenue Report" style="-fx-text-fill:#c7d4ea; -fx-font-size:12;"/>
                <Separator style="-fx-background-color:#2e5b91;"/>
                <Button prefWidth="208" prefHeight="38" text="✕  Close Window"
                        style="-fx-background-color:#c0392b; -fx-text-fill:white; -fx-alignment:BASELINE_LEFT; -fx-background-radius:8;"
                        onAction="#handleClose"/>
            </children>
        </VBox>

        <!-- TITLE -->
        <Label layoutX="268" layoutY="28"
               style="-fx-font-size:26; -fx-font-weight:bold; -fx-text-fill:#183153;"
               text="💰 Revenue Report"/>

        <!-- SUMMARY CARDS -->
        <HBox layoutX="268" layoutY="76" spacing="16">
            <children>
                <VBox prefWidth="220" prefHeight="80" spacing="4" alignment="CENTER"
                      style="-fx-background-color:white; -fx-background-radius:10; -fx-border-color:#d9e2ec; -fx-border-radius:10; -fx-padding:14;">
                    <Label text="Total Revenue" style="-fx-text-fill:#516173; -fx-font-size:12;"/>
                    <Label text="$—" style="-fx-font-size:22; -fx-font-weight:bold; -fx-text-fill:#183153;"/>
                </VBox>
                <VBox prefWidth="220" prefHeight="80" spacing="4" alignment="CENTER"
                      style="-fx-background-color:white; -fx-background-radius:10; -fx-border-color:#d9e2ec; -fx-border-radius:10; -fx-padding:14;">
                    <Label text="Total Collected" style="-fx-text-fill:#516173; -fx-font-size:12;"/>
                    <Label text="$—" style="-fx-font-size:22; -fx-font-weight:bold; -fx-text-fill:#2d7d46;"/>
                </VBox>
                <VBox prefWidth="220" prefHeight="80" spacing="4" alignment="CENTER"
                      style="-fx-background-color:white; -fx-background-radius:10; -fx-border-color:#d9e2ec; -fx-border-radius:10; -fx-padding:14;">
                    <Label text="Outstanding" style="-fx-text-fill:#516173; -fx-font-size:12;"/>
                    <Label text="$—" style="-fx-font-size:22; -fx-font-weight:bold; -fx-text-fill:#c0392b;"/>
                </VBox>
            </children>
        </HBox>

        <!-- DATE FILTER + EXPORT -->
        <HBox layoutX="268" layoutY="172" spacing="14" alignment="CENTER_LEFT">
            <children>
                <Label text="From:"/>
                <DatePicker prefWidth="160"/>
                <Label text="To:"/>
                <DatePicker prefWidth="160"/>
                <Button text="Filter" prefHeight="34"
                        style="-fx-background-color:#183153; -fx-text-fill:white; -fx-background-radius:8;"/>
                <Button text="Show All" prefHeight="34"
                        style="-fx-background-color:#dfe6ee; -fx-background-radius:8;"/>
                <Button text="Export CSV" prefHeight="34"
                        style="-fx-background-color:#2d7d46; -fx-text-fill:white; -fx-background-radius:8;"/>
                <Button text="Export PDF" prefHeight="34"
                        style="-fx-background-color:#8b3a9c; -fx-text-fill:white; -fx-background-radius:8;"/>
            </children>
        </HBox>

        <!-- TABLE -->
        <TableView layoutX="268" layoutY="218" prefHeight="620" prefWidth="1116">
            <columns>
                <TableColumn prefWidth="70"  text="Res. ID"/>
                <TableColumn prefWidth="160" text="Guest Name"/>
                <TableColumn prefWidth="120" text="Room"/>
                <TableColumn prefWidth="110" text="Check-In"/>
                <TableColumn prefWidth="110" text="Check-Out"/>
                <TableColumn prefWidth="70"  text="Nights"/>
                <TableColumn prefWidth="110" text="Subtotal"/>
                <TableColumn prefWidth="100" text="Add-Ons"/>
                <TableColumn prefWidth="100" text="Discount"/>
                <TableColumn prefWidth="90"  text="Tax"/>
                <TableColumn prefWidth="110" text="Total"/>
                <TableColumn prefWidth="100" text="Paid"/>
                <TableColumn prefWidth="100" text="Balance"/>
            </columns>
            <placeholder>
                <Label text="No data for the selected period." style="-fx-text-fill:#516173;"/>
            </placeholder>
        </TableView>

        <Button layoutX="268" layoutY="852" text="✕  Close" prefHeight="38" prefWidth="120"
                style="-fx-background-color:#516173; -fx-text-fill:white; -fx-background-radius:8;"
                onAction="#handleClose"/>

    </children>
</AnchorPane>
