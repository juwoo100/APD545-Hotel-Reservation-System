<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="900" prefWidth="1400" style="-fx-background-color:#f4f6fa;"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ca.seneca.application.controller.AdminLoyaltyController">
    <children>

        <!-- SIDEBAR -->
        <VBox layoutX="0" layoutY="0" prefHeight="900" prefWidth="240" spacing="8"
              style="-fx-background-color:#183153;">
            <padding><Insets top="28" left="16" right="16" bottom="20"/></padding>
            <children>
                <Label text="Hotel Admin" style="-fx-text-fill:white; -fx-font-size:20; -fx-font-weight:bold;"/>
                <Label text="Loyalty Program" style="-fx-text-fill:#c7d4ea; -fx-font-size:12;"/>
                <Separator style="-fx-background-color:#2e5b91;"/>
                <Button prefWidth="208" prefHeight="38" text="✕  Close Window"
                        style="-fx-background-color:#c0392b; -fx-text-fill:white; -fx-alignment:BASELINE_LEFT; -fx-background-radius:8;"
                        onAction="#handleClose"/>
            </children>
        </VBox>

        <!-- TITLE + INFO -->
        <Label layoutX="268" layoutY="28"
               style="-fx-font-size:26; -fx-font-weight:bold; -fx-text-fill:#183153;"
               text="⭐ Loyalty Program"/>

        <!-- SUMMARY CARDS -->
        <HBox layoutX="268" layoutY="76" spacing="16">
            <children>
                <VBox prefWidth="200" prefHeight="80" spacing="4" alignment="CENTER"
                      style="-fx-background-color:white; -fx-background-radius:10; -fx-border-color:#d9e2ec; -fx-border-radius:10; -fx-padding:14;">
                    <Label text="Total Members" style="-fx-text-fill:#516173; -fx-font-size:12;"/>
                    <Label text="—" style="-fx-font-size:22; -fx-font-weight:bold; -fx-text-fill:#183153;"/>
                </VBox>
                <VBox prefWidth="200" prefHeight="80" spacing="4" alignment="CENTER"
                      style="-fx-background-color:white; -fx-background-radius:10; -fx-border-color:#d9e2ec; -fx-border-radius:10; -fx-padding:14;">
                    <Label text="Total Points Issued" style="-fx-text-fill:#516173; -fx-font-size:12;"/>
                    <Label text="—" style="-fx-font-size:22; -fx-font-weight:bold; -fx-text-fill:#e67e22;"/>
                </VBox>
                <VBox prefWidth="260" prefHeight="80" spacing="4" alignment="CENTER"
                      style="-fx-background-color:white; -fx-background-radius:10; -fx-border-color:#d9e2ec; -fx-border-radius:10; -fx-padding:14;">
                    <Label text="Earning Rate" style="-fx-text-fill:#516173; -fx-font-size:12;"/>
                    <Label text="1 point per $1 spent" style="-fx-font-size:16; -fx-font-weight:bold; -fx-text-fill:#183153;"/>
                </VBox>
            </children>
        </HBox>

        <!-- SEARCH -->
        <HBox layoutX="268" layoutY="174" spacing="12" alignment="CENTER_LEFT">
            <children>
                <TextField prefWidth="260" prefHeight="34" promptText="Search member name or loyalty number..."/>
                <Button text="Search" prefHeight="34"
                        style="-fx-background-color:#183153; -fx-text-fill:white; -fx-background-radius:8;"/>
                <Button text="Show All" prefHeight="34"
                        style="-fx-background-color:#dfe6ee; -fx-background-radius:8;"/>
            </children>
        </HBox>

        <!-- TABLE -->
        <TableView layoutX="268" layoutY="220" prefHeight="618" prefWidth="1116">
            <columns>
                <TableColumn prefWidth="70"  text="Guest ID"/>
                <TableColumn prefWidth="180" text="Full Name"/>
                <TableColumn prefWidth="140" text="Phone"/>
                <TableColumn prefWidth="180" text="Loyalty Number"/>
                <TableColumn prefWidth="130" text="Points Balance"/>
                <TableColumn prefWidth="140" text="Total Spent ($)"/>
                <TableColumn prefWidth="130" text="Member Since"/>
                <TableColumn prefWidth="120" text="# Stays"/>
            </columns>
            <placeholder>
                <Label text="No loyalty members found." style="-fx-text-fill:#516173;"/>
            </placeholder>
        </TableView>

        <!-- CLOSE -->
        <Button layoutX="268" layoutY="852" text="✕  Close" prefHeight="38" prefWidth="120"
                style="-fx-background-color:#516173; -fx-text-fill:white; -fx-background-radius:8;"
                onAction="#handleClose"/>

    </children>
</AnchorPane>
