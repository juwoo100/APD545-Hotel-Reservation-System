<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="900" prefWidth="1400" style="-fx-background-color:#f4f6fa;"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ca.seneca.application.controller.AdminFeedbackController">
    <children>

        <!-- SIDEBAR -->
        <VBox layoutX="0" layoutY="0" prefHeight="900" prefWidth="240" spacing="8"
              style="-fx-background-color:#183153;">
            <padding><Insets top="28" left="16" right="16" bottom="20"/></padding>
            <children>
                <Label text="Hotel Admin" style="-fx-text-fill:white; -fx-font-size:20; -fx-font-weight:bold;"/>
                <Label text="Guest Feedback" style="-fx-text-fill:#c7d4ea; -fx-font-size:12;"/>
                <Separator style="-fx-background-color:#2e5b91;"/>
                <Button prefWidth="208" prefHeight="38" text="✕  Close Window"
                        style="-fx-background-color:#c0392b; -fx-text-fill:white; -fx-alignment:BASELINE_LEFT; -fx-background-radius:8;"
                        onAction="#handleClose"/>
            </children>
        </VBox>

        <!-- TITLE -->
        <Label layoutX="268" layoutY="28"
               style="-fx-font-size:26; -fx-font-weight:bold; -fx-text-fill:#183153;"
               text="💬 Guest Feedback"/>

        <!-- SUMMARY -->
        <HBox layoutX="268" layoutY="76" spacing="16">
            <children>
                <VBox prefWidth="200" prefHeight="80" spacing="4" alignment="CENTER"
                      style="-fx-background-color:white; -fx-background-radius:10; -fx-border-color:#d9e2ec; -fx-border-radius:10; -fx-padding:14;">
                    <Label text="Total Reviews" style="-fx-text-fill:#516173; -fx-font-size:12;"/>
                    <Label text="—" style="-fx-font-size:22; -fx-font-weight:bold; -fx-text-fill:#183153;"/>
                </VBox>
                <VBox prefWidth="200" prefHeight="80" spacing="4" alignment="CENTER"
                      style="-fx-background-color:white; -fx-background-radius:10; -fx-border-color:#d9e2ec; -fx-border-radius:10; -fx-padding:14;">
                    <Label text="Average Rating" style="-fx-text-fill:#516173; -fx-font-size:12;"/>
                    <Label text="— / 5" style="-fx-font-size:22; -fx-font-weight:bold; -fx-text-fill:#e67e22;"/>
                </VBox>
            </children>
        </HBox>

        <!-- FILTER -->
        <HBox layoutX="268" layoutY="174" spacing="12" alignment="CENTER_LEFT">
            <children>
                <Label text="Filter by rating:"/>
                <ComboBox prefWidth="140" prefHeight="34" promptText="All Ratings"/>
                <Button text="Filter" prefHeight="34"
                        style="-fx-background-color:#183153; -fx-text-fill:white; -fx-background-radius:8;"/>
                <Button text="Show All" prefHeight="34"
                        style="-fx-background-color:#dfe6ee; -fx-background-radius:8;"/>
            </children>
        </HBox>

        <!-- TABLE -->
        <TableView layoutX="268" layoutY="220" prefHeight="580" prefWidth="1116">
            <columns>
                <TableColumn prefWidth="70"  text="ID"/>
                <TableColumn prefWidth="160" text="Guest Name"/>
                <TableColumn prefWidth="100" text="Res. ID"/>
                <TableColumn prefWidth="100" text="Rating"/>
                <TableColumn prefWidth="120" text="Date"/>
                <TableColumn prefWidth="560" text="Comment"/>
            </columns>
            <placeholder>
                <Label text="No feedback submitted yet." style="-fx-text-fill:#516173;"/>
            </placeholder>
        </TableView>

        <!-- DETAIL VIEW -->
        <VBox layoutX="268" layoutY="814" spacing="8"
              style="-fx-background-color:white; -fx-padding:14; -fx-background-radius:10; -fx-border-color:#d9e2ec; -fx-border-radius:10;"
              prefWidth="760" prefHeight="60">
            <children>
                <Label text="Select a row above to read the full comment."
                       style="-fx-text-fill:#888888; -fx-font-size:13; -fx-font-style:italic;"/>
            </children>
        </VBox>

        <Button layoutX="268" layoutY="856" text="✕  Close" prefHeight="38" prefWidth="120"
                style="-fx-background-color:#516173; -fx-text-fill:white; -fx-background-radius:8;"
                layoutY="852"
                onAction="#handleClose"/>

    </children>
</AnchorPane>
