<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="900" prefWidth="1400" style="-fx-background-color:#f4f6fa;"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ca.seneca.application.controller.AdminCheckoutController">
    <children>

        <!-- SIDEBAR -->
        <VBox layoutX="0" layoutY="0" prefHeight="900" prefWidth="240" spacing="8"
              style="-fx-background-color:#183153;">
            <padding><Insets top="28" left="16" right="16" bottom="20"/></padding>
            <children>
                <Label text="Hotel Admin" style="-fx-text-fill:white; -fx-font-size:20; -fx-font-weight:bold;"/>
                <Label text="Guest Checkout" style="-fx-text-fill:#c7d4ea; -fx-font-size:12;"/>
                <Separator style="-fx-background-color:#2e5b91;"/>
                <Button prefWidth="208" prefHeight="38" text="✕  Close Window"
                        style="-fx-background-color:#c0392b; -fx-text-fill:white; -fx-alignment:BASELINE_LEFT; -fx-background-radius:8;"
                        onAction="#handleClose"/>
            </children>
        </VBox>

        <!-- TITLE -->
        <Label layoutX="268" layoutY="28"
               style="-fx-font-size:26; -fx-font-weight:bold; -fx-text-fill:#183153;"
               text="🚪 Guest Checkout"/>

        <!-- INFO LABEL -->
        <Label layoutX="268" layoutY="72"
               style="-fx-font-size:13; -fx-text-fill:#516173;"
               text="Shows guests currently CHECKED IN. Balance must be $0.00 before checkout can be processed."/>

        <!-- TABLE -->
        <TableView layoutX="268" layoutY="106" prefHeight="680" prefWidth="1116">
            <columns>
                <TableColumn prefWidth="70"  text="Res. ID"/>
                <TableColumn prefWidth="180" text="Guest Name"/>
                <TableColumn prefWidth="130" text="Phone"/>
                <TableColumn prefWidth="130" text="Room"/>
                <TableColumn prefWidth="110" text="Check-In"/>
                <TableColumn prefWidth="120" text="Check-Out Date"/>
                <TableColumn prefWidth="80"  text="Nights"/>
                <TableColumn prefWidth="120" text="Total"/>
                <TableColumn prefWidth="110" text="Balance"/>
            </columns>
            <placeholder>
                <Label text="No guests currently checked in." style="-fx-text-fill:#516173;"/>
            </placeholder>
        </TableView>

        <!-- ACTIONS -->
        <HBox layoutX="268" layoutY="800" spacing="12" alignment="CENTER_LEFT">
            <children>
                <Button text="✔  Process Checkout" prefHeight="42" prefWidth="200"
                        style="-fx-background-color:#183153; -fx-text-fill:white; -fx-font-weight:bold; -fx-background-radius:8;"/>
                <Label text="" style="-fx-text-fill:#c0392b; -fx-font-size:13;"/>
                <Button text="✕  Close" prefHeight="42" prefWidth="100"
                        style="-fx-background-color:#516173; -fx-text-fill:white; -fx-background-radius:8;"
                        onAction="#handleClose"/>
            </children>
        </HBox>

    </children>
</AnchorPane>
