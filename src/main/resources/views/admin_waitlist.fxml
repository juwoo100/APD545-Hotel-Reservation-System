<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="900" prefWidth="1400" style="-fx-background-color:#f4f6fa;"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ca.seneca.application.controller.AdminWaitlistController">
    <children>

        <!-- SIDEBAR -->
        <VBox layoutX="0" layoutY="0" prefHeight="900" prefWidth="240" spacing="8"
              style="-fx-background-color:#183153;">
            <padding><Insets top="28" left="16" right="16" bottom="20"/></padding>
            <children>
                <Label text="Hotel Admin" style="-fx-text-fill:white; -fx-font-size:20; -fx-font-weight:bold;"/>
                <Label text="Waitlist" style="-fx-text-fill:#c7d4ea; -fx-font-size:12;"/>
                <Separator style="-fx-background-color:#2e5b91;"/>
                <Button prefWidth="208" prefHeight="38" text="✕  Close Window"
                        style="-fx-background-color:#c0392b; -fx-text-fill:white; -fx-alignment:BASELINE_LEFT; -fx-background-radius:8;"
                        onAction="#handleClose"/>
            </children>
        </VBox>

        <!-- TITLE -->
        <Label layoutX="268" layoutY="28"
               style="-fx-font-size:26; -fx-font-weight:bold; -fx-text-fill:#183153;"
               text="⏳ Waitlist"/>

        <Label layoutX="268" layoutY="72"
               style="-fx-font-size:13; -fx-text-fill:#516173;"
               text="Guests waiting for a room type to become available. First added = first notified when a room opens."/>

        <!-- FILTER -->
        <HBox layoutX="268" layoutY="102" spacing="12" alignment="CENTER_LEFT">
            <children>
                <Label text="Filter by room type:"/>
                <ComboBox prefWidth="160" prefHeight="34" promptText="All Types"/>
                <Button text="Filter" prefHeight="34"
                        style="-fx-background-color:#183153; -fx-text-fill:white; -fx-background-radius:8;"/>
            </children>
        </HBox>

        <!-- TABLE -->
        <TableView layoutX="268" layoutY="148" prefHeight="680" prefWidth="1116">
            <columns>
                <TableColumn prefWidth="70"  text="ID"/>
                <TableColumn prefWidth="180" text="Guest Name"/>
                <TableColumn prefWidth="140" text="Phone"/>
                <TableColumn prefWidth="140" text="Room Type"/>
                <TableColumn prefWidth="130" text="Desired Check-In"/>
                <TableColumn prefWidth="130" text="Desired Check-Out"/>
                <TableColumn prefWidth="160" text="Added At"/>
                <TableColumn prefWidth="100" text="Notified"/>
            </columns>
            <placeholder>
                <Label text="No guests on the waitlist." style="-fx-text-fill:#516173;"/>
            </placeholder>
        </TableView>

        <!-- ACTIONS -->
        <HBox layoutX="268" layoutY="842" spacing="12">
            <children>
                <Button text="✕  Close" prefHeight="38" prefWidth="120"
                        style="-fx-background-color:#516173; -fx-text-fill:white; -fx-background-radius:8;"
                        onAction="#handleClose"/>
            </children>
        </HBox>

    </children>
</AnchorPane>
