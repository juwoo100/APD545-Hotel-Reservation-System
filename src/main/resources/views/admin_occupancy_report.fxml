<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="900" prefWidth="1400" style="-fx-background-color:#f4f6fa;"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ca.seneca.application.controller.AdminOccupancyReportController">
    <children>

        <!-- SIDEBAR -->
        <VBox layoutX="0" layoutY="0" prefHeight="900" prefWidth="240" spacing="8"
              style="-fx-background-color:#183153;">
            <padding><Insets top="28" left="16" right="16" bottom="20"/></padding>
            <children>
                <Label text="Hotel Admin" style="-fx-text-fill:white; -fx-font-size:20; -fx-font-weight:bold;"/>
                <Label text="Occupancy Report" style="-fx-text-fill:#c7d4ea; -fx-font-size:12;"/>
                <Separator style="-fx-background-color:#2e5b91;"/>
                <Button prefWidth="208" prefHeight="38" text="✕  Close Window"
                        style="-fx-background-color:#c0392b; -fx-text-fill:white; -fx-alignment:BASELINE_LEFT; -fx-background-radius:8;"
                        onAction="#handleClose"/>
            </children>
        </VBox>

        <!-- TITLE -->
        <Label layoutX="268" layoutY="28"
               style="-fx-font-size:26; -fx-font-weight:bold; -fx-text-fill:#183153;"
               text="📈 Occupancy Report"/>

        <!-- STAT CARDS -->
        <HBox layoutX="268" layoutY="76" spacing="16">
            <children>
                <VBox prefWidth="200" prefHeight="90" spacing="4" alignment="CENTER"
                      style="-fx-background-color:white; -fx-background-radius:10; -fx-border-color:#d9e2ec; -fx-border-radius:10; -fx-padding:14;">
                    <Label text="Overall Occupancy" style="-fx-text-fill:#516173; -fx-font-size:12;"/>
                    <Label text="— %" style="-fx-font-size:26; -fx-font-weight:bold; -fx-text-fill:#183153;"/>
                </VBox>
                <VBox prefWidth="180" prefHeight="90" spacing="4" alignment="CENTER"
                      style="-fx-background-color:white; -fx-background-radius:10; -fx-border-color:#d9e2ec; -fx-border-radius:10; -fx-padding:14;">
                    <Label text="Single Rooms" style="-fx-text-fill:#516173; -fx-font-size:12;"/>
                    <Label text="— / —" style="-fx-font-size:20; -fx-font-weight:bold; -fx-text-fill:#2d7d46;"/>
                </VBox>
                <VBox prefWidth="180" prefHeight="90" spacing="4" alignment="CENTER"
                      style="-fx-background-color:white; -fx-background-radius:10; -fx-border-color:#d9e2ec; -fx-border-radius:10; -fx-padding:14;">
                    <Label text="Double Rooms" style="-fx-text-fill:#516173; -fx-font-size:12;"/>
                    <Label text="— / —" style="-fx-font-size:20; -fx-font-weight:bold; -fx-text-fill:#2d7d46;"/>
                </VBox>
                <VBox prefWidth="180" prefHeight="90" spacing="4" alignment="CENTER"
                      style="-fx-background-color:white; -fx-background-radius:10; -fx-border-color:#d9e2ec; -fx-border-radius:10; -fx-padding:14;">
                    <Label text="Deluxe Rooms" style="-fx-text-fill:#516173; -fx-font-size:12;"/>
                    <Label text="— / —" style="-fx-font-size:20; -fx-font-weight:bold; -fx-text-fill:#e67e22;"/>
                </VBox>
                <VBox prefWidth="180" prefHeight="90" spacing="4" alignment="CENTER"
                      style="-fx-background-color:white; -fx-background-radius:10; -fx-border-color:#d9e2ec; -fx-border-radius:10; -fx-padding:14;">
                    <Label text="Penthouse" style="-fx-text-fill:#516173; -fx-font-size:12;"/>
                    <Label text="— / —" style="-fx-font-size:20; -fx-font-weight:bold; -fx-text-fill:#8b3a9c;"/>
                </VBox>
            </children>
        </HBox>

        <!-- ACTIONS -->
        <HBox layoutX="268" layoutY="182" spacing="12" alignment="CENTER_LEFT">
            <children>
                <Button text="🔄 Refresh" prefHeight="34"
                        style="-fx-background-color:#183153; -fx-text-fill:white; -fx-background-radius:8;"/>
                <Button text="Export CSV" prefHeight="34"
                        style="-fx-background-color:#2d7d46; -fx-text-fill:white; -fx-background-radius:8;"/>
            </children>
        </HBox>

        <!-- TABLE -->
        <TableView layoutX="268" layoutY="228" prefHeight="610" prefWidth="1116">
            <columns>
                <TableColumn prefWidth="70"  text="Res. ID"/>
                <TableColumn prefWidth="180" text="Guest Name"/>
                <TableColumn prefWidth="110" text="Room No."/>
                <TableColumn prefWidth="130" text="Room Type"/>
                <TableColumn prefWidth="120" text="Check-In"/>
                <TableColumn prefWidth="120" text="Check-Out"/>
                <TableColumn prefWidth="80"  text="Nights"/>
                <TableColumn prefWidth="110" text="Status"/>
            </columns>
            <placeholder>
                <Label text="No active reservations." style="-fx-text-fill:#516173;"/>
            </placeholder>
        </TableView>

        <Button layoutX="268" layoutY="852" text="✕  Close" prefHeight="38" prefWidth="120"
                style="-fx-background-color:#516173; -fx-text-fill:white; -fx-background-radius:8;"
                onAction="#handleClose"/>

    </children>
</AnchorPane>
