<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="900" prefWidth="1400"
            style="-fx-background-color:linear-gradient(to bottom,#f6f8fb,#e9eef5);"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ca.seneca.application.controller.KioskReviewController">
    <children>
        <VBox layoutX="20" layoutY="20" prefHeight="860" prefWidth="240" spacing="16"
              style="-fx-background-color:#183153; -fx-background-radius:16;">
            <padding><Insets top="28" left="20" right="20" bottom="28"/></padding>
            <children>
                <Label text="Sheraton Hotel" style="-fx-text-fill:white; -fx-font-size:22; -fx-font-weight:bold;"/>
                <Label text="Step 6 of 6"    style="-fx-text-fill:#c7d4ea; -fx-font-size:13;"/>
                <Separator opacity="0.3"/>
                <Label text="✅ Guests"  style="-fx-text-fill:#8aaccc; -fx-font-size:12;"/>
                <Label text="✅ Dates"   style="-fx-text-fill:#8aaccc; -fx-font-size:12;"/>
                <Label text="✅ Rooms"   style="-fx-text-fill:#8aaccc; -fx-font-size:12;"/>
                <Label text="✅ Details" style="-fx-text-fill:#8aaccc; -fx-font-size:12;"/>
                <Label text="✅ Add-Ons" style="-fx-text-fill:#8aaccc; -fx-font-size:12;"/>
                <Label text="▶ Review"  style="-fx-text-fill:white; -fx-font-size:12; -fx-font-weight:bold;"/>
            </children>
        </VBox>

        <VBox layoutX="295" layoutY="30" prefWidth="860" spacing="20">
            <children>
                <Label text="Review Your Booking"
                       style="-fx-font-size:34; -fx-font-weight:bold; -fx-text-fill:#183153;"/>

                <VBox spacing="12" style="-fx-background-color:white; -fx-padding:30; -fx-background-radius:14; -fx-border-color:#d9e2ec; -fx-border-radius:14;">
                    <children>
                        <Label text="Guest Information" style="-fx-font-size:16; -fx-font-weight:bold; -fx-text-fill:#183153;"/>
                        <HBox spacing="16">
                            <Label text="Name:"  style="-fx-font-weight:bold; -fx-min-width:120;"/>
                            <Label fx:id="guestNameLabel" text=""/>
                        </HBox>
                        <HBox spacing="16">
                            <Label text="Phone:" style="-fx-font-weight:bold; -fx-min-width:120;"/>
                            <Label fx:id="phoneLabel" text=""/>
                        </HBox>
                        <HBox spacing="16">
                            <Label text="Email:" style="-fx-font-weight:bold; -fx-min-width:120;"/>
                            <Label fx:id="emailLabel" text=""/>
                        </HBox>

                        <Separator/>
                        <Label text="Stay Details" style="-fx-font-size:16; -fx-font-weight:bold; -fx-text-fill:#183153;"/>
                        <HBox spacing="16">
                            <Label text="Dates:"  style="-fx-font-weight:bold; -fx-min-width:120;"/>
                            <Label fx:id="stayDatesLabel" text=""/>
                        </HBox>
                        <HBox spacing="16">
                            <Label text="Nights:" style="-fx-font-weight:bold; -fx-min-width:120;"/>
                            <Label fx:id="nightsLabel" text=""/>
                        </HBox>
                        <HBox spacing="16">
                            <Label text="Rooms:"  style="-fx-font-weight:bold; -fx-min-width:120;"/>
                            <Label fx:id="roomSummaryLabel" text="" wrapText="true"/>
                        </HBox>
                        <HBox spacing="16">
                            <Label text="Add-Ons:" style="-fx-font-weight:bold; -fx-min-width:120;"/>
                            <Label fx:id="addOnsLabel" text=""/>
                        </HBox>

                        <Separator/>
                        <Label text="Pricing" style="-fx-font-size:16; -fx-font-weight:bold; -fx-text-fill:#183153;"/>
                        <HBox spacing="16">
                            <Label text="Subtotal:" style="-fx-font-weight:bold; -fx-min-width:120;"/>
                            <Label fx:id="subtotalLabel" text=""/>
                        </HBox>
                        <HBox spacing="16">
                            <Label text="Tax (HST):" style="-fx-font-weight:bold; -fx-min-width:120;"/>
                            <Label fx:id="taxLabel" text=""/>
                        </HBox>
                        <HBox spacing="16">
                            <Label text="TOTAL:" style="-fx-font-size:18; -fx-font-weight:bold; -fx-min-width:120;"/>
                            <Label fx:id="totalLabel" style="-fx-font-size:18; -fx-font-weight:bold; -fx-text-fill:#183153;" text=""/>
                        </HBox>
                    </children>
                </VBox>

                <HBox spacing="16">
                    <children>
                        <Button text="← Back" prefWidth="150" prefHeight="46"
                                style="-fx-background-color:#dfe6ee; -fx-background-radius:10;"
                                onAction="#handleBack"/>
                        <Button text="✔  Confirm Reservation" prefWidth="240" prefHeight="46"
                                style="-fx-background-color:#2d7d46; -fx-text-fill:white; -fx-font-size:16; -fx-font-weight:bold; -fx-background-radius:10;"
                                onAction="#handleConfirmReservation"/>
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>
