<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="900" prefWidth="1400" style="-fx-background-color:#f4f6fa;"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ca.seneca.application.controller.AdminReservationsController">
    <children>

        <!-- SIDEBAR -->
        <VBox layoutX="0" layoutY="0" prefHeight="900" prefWidth="240" spacing="8"
              style="-fx-background-color:#183153;">
            <padding><Insets top="28" left="16" right="16" bottom="20"/></padding>
            <children>
                <Label text="Hotel Admin" style="-fx-text-fill:white; -fx-font-size:20; -fx-font-weight:bold;"/>
                <Label text="Reservations" style="-fx-text-fill:#c7d4ea; -fx-font-size:12;"/>
                <Separator style="-fx-background-color:#2e5b91;"/>
                <Button prefWidth="208" prefHeight="38" text="✕  Close Window"
                        style="-fx-background-color:#c0392b; -fx-text-fill:white; -fx-alignment:BASELINE_LEFT; -fx-background-radius:8;"
                        onAction="#handleClose"/>
            </children>
        </VBox>

        <!-- TITLE -->
        <Label layoutX="268" layoutY="28"
               style="-fx-font-size:26; -fx-font-weight:bold; -fx-text-fill:#183153;"
               text="📋 All Reservations"/>

        <!-- SEARCH ROW -->
        <HBox layoutX="268" layoutY="76" spacing="12" alignment="CENTER_LEFT">
            <children>
                <TextField prefWidth="200" prefHeight="34" promptText="Search guest name..."/>
                <ComboBox prefWidth="150" prefHeight="34" promptText="Status"/>
                <DatePicker prefHeight="34" promptText="Check-In From"/>
                <DatePicker prefHeight="34" promptText="Check-In To"/>
                <Button text="Search" prefHeight="34"
                        style="-fx-background-color:#183153; -fx-text-fill:white; -fx-background-radius:8;"/>
                <Button text="Clear" prefHeight="34"
                        style="-fx-background-color:#dfe6ee; -fx-background-radius:8;"/>
            </children>
        </HBox>

        <!-- TABLE -->
        <TableView layoutX="268" layoutY="124" prefHeight="680" prefWidth="1116">
            <columns>
                <TableColumn prefWidth="70"  text="ID"/>
                <TableColumn prefWidth="160" text="Guest Name"/>
                <TableColumn prefWidth="130" text="Phone"/>
                <TableColumn prefWidth="130" text="Room"/>
                <TableColumn prefWidth="110" text="Check-In"/>
                <TableColumn prefWidth="110" text="Check-Out"/>
                <TableColumn prefWidth="80"  text="Nights"/>
                <TableColumn prefWidth="110" text="Total"/>
                <TableColumn prefWidth="110" text="Balance"/>
                <TableColumn prefWidth="110" text="Status"/>
            </columns>
            <placeholder>
                <Label text="No reservations found." style="-fx-text-fill:#516173;"/>
            </placeholder>
        </TableView>

        <!-- ACTION BUTTONS -->
        <HBox layoutX="268" layoutY="818" spacing="12">
            <children>
                <Button text="✔  Check In Guest" prefHeight="38" prefWidth="170"
                        style="-fx-background-color:#2d7d46; -fx-text-fill:white; -fx-background-radius:8;"/>
                <Button text="✖  Cancel Reservation" prefHeight="38" prefWidth="180"
                        style="-fx-background-color:#c0392b; -fx-text-fill:white; -fx-background-radius:8;"/>
                <Button text="✕  Close" prefHeight="38" prefWidth="100"
                        style="-fx-background-color:#516173; -fx-text-fill:white; -fx-background-radius:8;"
                        onAction="#handleClose"/>
            </children>
        </HBox>

    </children>
</AnchorPane>
